{
  "name": "005-coach-mate-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "test": "npm run test:unit && npm run test:runtime",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:optimizer": "node --experimental-strip-types --test tests/substitution.test.mjs",
    "verify:optimizer": "node --experimental-strip-types scripts/verify-substitution.mjs",
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "playwright test",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:state": "node --experimental-strip-types --test tests/coach-state.test.mjs",
    "test:app": "playwright test tests/coach-app.spec.ts",
    "audit:security": "node --use-system-ca scripts/audit-dependencies.mjs",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "prebuild": "npm run check:runtime",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs",
    "backend": "node --use-system-ca --env-file-if-exists=.env --experimental-strip-types server/index.mjs",
    "test:backend": "node --experimental-strip-types --test tests/backend.test.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "google-auth-library": "^11.1.0",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
