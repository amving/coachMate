# Copy to .env and fill the two OAuth values locally. Never put a secret in VITE_*.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SPREADSHEET_ID=1nmvI_t5GP6WR1LhBwYjeUVXcnXV-QY-InxjJASwStlQ
COACH_EMAILS=
APP_ORIGIN=http://127.0.0.1:4173
API_ORIGIN=http://127.0.0.1:4175
API_PORT=4175
VITE_API_ORIGIN=http://127.0.0.1:4175
# Optioneel. Cloud Run gebruikt Application Default Credentials voor Vertex AI in de EU.
COACHMATE_GEMINI_SWAP_ENABLED=false
COACHMATE_GEMINI_PROJECT=

# Local Firestore pilot only. Production continues using Sheets.
COACHMATE_APP_STORE=sheets
COACHMATE_APP_FIRESTORE_PROJECT=

# Optional parent pilot. Leave empty to keep the portal disabled.
COACHMATE_PARENT_ENABLED=false
COACHMATE_PARENT_CLIENT_ID=
COACHMATE_PARENT_CLIENT_SECRET=
COACHMATE_PARENT_SESSION_SECRET=
COACHMATE_PARENT_PROJECT=
COACHMATE_PARENT_DATABASE=
COACHMATE_PARENT_TEAMS=
# Optional Firebase Authentication web API key from the isolated parent project.
COACHMATE_PARENT_EMAIL_API_KEY=
# Requires the local Firestore app database and the parent portal.
COACHMATE_SHARED_LIVE_ENABLED=false
